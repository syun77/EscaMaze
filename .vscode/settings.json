{
    // 実行ファイル.
    "godot_tools.editor_path": "/Users/syun77/Library/Application Support/Steam/steamapps/common/Godot Engine/Godot.app",
    "godotTools.editorPath.godot4": "/Users/syun77/Library/Application Support/Steam/steamapps/common/Godot Engine/Godot.app",
    // 空白文字を見える化して、タブ/スペースの混在を検出しやすくする.
    "editor.renderWhitespace": "all",
    "editor.guides.indentation": true,
    "editor.guides.highlightActiveIndentation": true,
    // デフォルトはスペース固定（自動検出で切り替わらないようにする）.
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.tabSize": 4,
    // ポート番号.
    "godot_tools.gdscript_lsp_server_port": 6005,
    // タブ・空白文字を目立つ色で表示.
    "workbench.colorCustomizations": {
        "editorWhitespace.foreground": "#ff9900aa"
    },
    // GDScript もスペース固定（renderWhitespace で空白を可視化）.
    "[gdscript]": {
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.tabSize": 4,
        "editor.renderWhitespace": "all"
    },
    // デバッグ設定.
    "configurations": [
        {
            "name": "GDScript Godot",
            "type": "godot",
            "request": "launch",
            "project": "${workspaceFolder}",
            "port": 6007,
            "debugServer": 6006,
            "address": "127.0.0.1",
            "launch_game_instance": true,
            "launch_scene": false
        }
    ],
}